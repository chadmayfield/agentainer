# Secret files a user may create inside a checkout (the SSH host key, env files). The
# build-context ignore files exclude the same .env names.
host.key
env
.env
.env.*
.DS_Store
# Local notes; never commit them.
docs/private/

# Local visual-review dependencies and intermediate output.
/tests/visual/node_modules/
/artifacts/visual/*
!/artifacts/visual/index.md
!/artifacts/visual/screenshots/
/artifacts/visual/screenshots/*
!/artifacts/visual/screenshots/*.png

# Local agent scratch directories; never commit them.
/.superpowers/

# Python bytecode from running tests.
__pycache__/
