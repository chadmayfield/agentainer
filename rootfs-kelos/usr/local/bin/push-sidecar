#!/bin/bash -p
# Pushes the agent's work to a branch while a Kelos Task runs, and once more when
# the pod is told to stop. It runs as a sidecar (an init container with
# restartPolicy: Always) next to the agent, so the work survives a deadline kill.
#
# Environment:
#   PUSH_URL                https://github.com/<owner>/<repo>.git, the push target (required)
#   PUSH_BRANCH             branch to push to (required)
#   KELOS_GITHUB_TOKEN_FILE file that holds the GitHub token (required)
#   GIT_AUTHOR_NAME, GIT_AUTHOR_EMAIL
#                           identity of the WIP commit (required: the sidecar
#                           ignores the user and system git config, so git has
#                           no other identity)
#   GIT_COMMITTER_NAME, GIT_COMMITTER_EMAIL
#                           optional; each falls back to the author value
#   PUSH_REPO               repository directory (default /workspace/repo)
#   PUSH_INTERVAL           seconds between pushes (default 900)
#   PUSH_ALLOW_FILE_REMOTE  set to 1 to accept an absolute local path as PUSH_URL (tests)
#   HTTPS_PROXY, https_proxy, GIT_SSL_CAINFO
#                           read by git as usual
#
# Every push attempt prints "push-ok" or "push-failed: <reason>". Other lines start
# with "push-note:". The exit status is that of the final push after SIGTERM: 0 for
# push-ok, 1 for push-failed.
#
# What the "agent WIP" commit holds: the changes to files that HEAD has, whatever
# their name, and the new files, with three exceptions. A new file whose name, or
# the name of a directory above it, matches a pattern in
# /usr/local/share/push-sidecar/excludes stays out, also when the agent staged it.
# A new or changed file over 10 MB stays out. A change of the commit a submodule
# points to is not committed (see stage). A push-note line names the files kept out
# by name or size.
#
# Known limits: the sidecar pushes HEAD, so commits the agent made itself go out as
# they are, including secrets, files over 10 MB and conflict markers. A rule on the
# remote side (push protection, a size limit) is the only guard for those. Only
# https://github.com remotes are accepted. The image has no git-lfs, so a file that
# .gitattributes sends through the LFS filter is committed as a plain blob, not as
# an LFS pointer.
#
# Threat model: the repository content comes from the agent, so repo-level git
# config must not start commands or redirect the token. The agent already holds the
# same token (Kelos sets GITHUB_TOKEN and KELOS_GITHUB_TOKEN_FILE in the agent
# container), so this guards against the repository, not against the agent.
#
# Shutdown time: after the agent exits, the kubelet sends SIGTERM to the sidecar
# and the pod's termination grace period (30 s unless the pod sets another value)
# is all it has. Kelos v0.62.0 cannot set terminationGracePeriodSeconds on a Task
# pod. The final path therefore has a total budget of 20 s from the signal. Every
# git step in it runs under timeout with what is left of the budget, and the loop
# that checks file sizes stops when the budget is spent. It first pushes HEAD as it
# is, with at most 10 s, so the agent's own commits go out. It then commits the
# working tree changes and pushes again with whatever time is left. A periodic push
# or commit in flight is killed when SIGTERM arrives.
set -uo pipefail

repo=${PUSH_REPO:-/workspace/repo}
interval=${PUSH_INTERVAL:-900}
url=${PUSH_URL:-}
branch=${PUSH_BRANCH:-}
token_file=${KELOS_GITHUB_TOKEN_FILE:-}
GIT=/usr/bin/git
excludes=/usr/local/share/push-sidecar/excludes
max_bytes=$((10 * 1024 * 1024))
# The excludes file also feeds pathspecs. A negation in .gitignore or
# .git/info/exclude (!.env) can override core.excludesFile but not a pathspec.
# exclude_specs keeps new files with the listed names, and everything under a
# directory with such a name, out of "git add -A". secret_specs matches the same
# paths, to find such files that are already staged and to name them in a note.
exclude_specs=()
secret_specs=()
if [ -r "$excludes" ]; then
  while IFS= read -r pattern; do
    case "$pattern" in '' | '#'*) continue ;; esac
    exclude_specs+=(":(exclude,glob)**/$pattern" ":(exclude,glob)**/$pattern/**")
    secret_specs+=(":(glob)**/$pattern" ":(glob)**/$pattern/**")
  done <"$excludes"
fi

fail() {
  printf 'push-failed: %s\n' "$1"
  exit 1
}

[ -n "$url" ] || fail "PUSH_URL is not set"
if [ "${PUSH_ALLOW_FILE_REMOTE:-}" = 1 ]; then
  case "$url" in
  https://github.com/* | /*) ;;
  *) fail "PUSH_URL must be an https://github.com/<owner>/<repo>.git URL" ;;
  esac
  case "$url" in
  /*) ;;
  *) [[ $url =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fail "PUSH_URL must be an https://github.com/<owner>/<repo>.git URL" ;;
  esac
else
  [[ $url =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fail "PUSH_URL must be an https://github.com/<owner>/<repo>.git URL"
fi
[ -n "$branch" ] || fail "PUSH_BRANCH is not set"
case "$branch" in
-* | */ | *..* | *[[:space:]]*) fail "PUSH_BRANCH is not a valid branch name" ;;
esac
"$GIT" check-ref-format --branch "$branch" >/dev/null 2>&1 || fail "PUSH_BRANCH is not a valid branch name"
[ -n "$token_file" ] || fail "KELOS_GITHUB_TOKEN_FILE is not set"
[ -s "$token_file" ] && [ -r "$token_file" ] || fail "token file $token_file is missing, empty or unreadable"
case "$interval" in
'' | *[!0-9]* | 0) fail "PUSH_INTERVAL must be a positive number of seconds" ;;
esac

# The identity comes from the Task's environment. Git reads the author variables
# itself; the committer falls back to the author.
if [ -z "${GIT_AUTHOR_NAME:-}" ] || [ -z "${GIT_AUTHOR_EMAIL:-}" ]; then
  fail "GIT_AUTHOR_NAME and GIT_AUTHOR_EMAIL must be set"
fi
: "${GIT_COMMITTER_NAME:=$GIT_AUTHOR_NAME}"
: "${GIT_COMMITTER_EMAIL:=$GIT_AUTHOR_EMAIL}"
export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL

# Ignore the user and system git config, and prompts.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_TERMINAL_PROMPT=0
export HOME=${HOME:-/home/kelos}

# The credential helper reads the token file when git asks, so the token is never
# on a command line or in a URL. It is registered for https://github.com only, and
# the empty credential.helper entry clears every helper the repository config lists.
# shellcheck disable=SC2016 # the helper runs in a shell that expands it
helper='!f() { echo username=x-access-token; echo "password=$(cat "$KELOS_GITHUB_TOKEN_FILE")"; }; f'

# Flags that stop repository config from starting a command or changing where the
# token goes. Keys that cannot be switched off by a flag are refused in
# check_config. protocol.* allows https only (and a local path in tests).
# diff.ignoreSubmodules=dirty and status --ignore-submodules=dirty keep git from
# running "git status" inside a submodule, where the submodule's own config (a clean
# filter, for example) would apply. A change of the commit a submodule points to is
# still seen.
git_flags=(
  -c core.hooksPath=/dev/null
  -c core.fsmonitor=false
  -c core.sshCommand=false
  -c core.askPass=false
  -c commit.gpgsign=false
  -c tag.gpgsign=false
  -c protocol.allow=never
  -c protocol.https.allow=always
  -c http.sslVerify=true
  -c diff.ignoreSubmodules=dirty
  -c submodule.recurse=false
  -c "core.excludesFile=$excludes"
  -c "safe.directory=$repo"
  -c credential.helper=
  -c "credential.https://github.com.helper=$helper"
)
if [ "${PUSH_ALLOW_FILE_REMOTE:-}" = 1 ]; then
  git_flags+=(-c protocol.file.allow=always)
fi
if [ -n "${GIT_SSL_CAINFO:-}" ]; then
  git_flags+=(-c "http.sslCAInfo=$GIT_SSL_CAINFO")
fi
g() {
  "$GIT" -C "$repo" "${git_flags[@]}" "$@"
}

# One line, at most 400 characters, with the token removed.
clean() {
  local text=$1 tok
  tok=$(cat "$token_file" 2>/dev/null || true)
  if [ -n "$tok" ]; then
    text=${text//"$tok"/***}
  fi
  text=$(printf '%s' "$text" | tr '\n' ' ' | tr -s ' ')
  printf '%s' "${text:0:400}"
}

# Refuses a repository whose config could start a command or move the token:
#   include.*, includeIf.*   pull in config from files the agent can write
#   filter.*                 clean and smudge drivers run commands during git add
#   core.fsmonitor           a command that runs during status and add
#   core.sshCommand          a command that runs for ssh remotes
#   core.hooksPath           hooks directory
#   core.askPass, core.gitProxy, core.worktree  commands or a moved work tree
#   diff.*                   textconv and external diff drivers run commands
#   push.*, submodule.*      push.recurseSubmodules and submodule.recurse make a push
#                            follow submodules, whose own config this check never reads
#   remote.*                 pushurl, proxy and similar keys, also keyed by URL,
#                            redirect the push; only remote.origin.url and
#                            remote.origin.fetch pass (what git clone and Kelos write)
#   gpg.*                    a signing program that commit would run
#   url.*                    insteadOf and pushInsteadOf rewrite the push URL
#   http.*                   proxy, CA file, TLS verification and extra headers
#   protocol.*               which transports are allowed
#   credential.*             all except credential.helper and credential.username,
#                            which Kelos writes itself; the flags above clear them
# The keys are read with git config --file, which does not follow includes and runs
# nothing. Prints "unsafe git config (<key>)", or why the config could not be read,
# and returns 1; a repository whose config cannot be read is refused too.
check_config() {
  local common gitdir f key keys
  if ! common=$(g rev-parse --git-common-dir 2>/dev/null) ||
    ! gitdir=$(g rev-parse --git-dir 2>/dev/null); then
    printf 'cannot read the repository at %s' "$repo"
    return 1
  fi
  for f in "$repo/$common/config" "$repo/$gitdir/config.worktree" "$common/config" "$gitdir/config.worktree"; do
    [ -f "$f" ] || continue
    if ! keys=$("$GIT" config --file "$f" --list --name-only 2>/dev/null); then
      printf 'cannot read the git config file %s' "$f"
      return 1
    fi
    while IFS= read -r key; do
      key=${key,,}
      case "$key" in
      '' | credential.helper | credential.username | remote.origin.url | remote.origin.fetch) ;;
      remote.* | diff.* | push.* | submodule.* | include.* | includeif.* | filter.* | core.fsmonitor | core.sshcommand | core.hookspath | core.askpass | core.gitproxy | core.worktree | gpg.* | url.* | http.* | protocol.* | credential.* | credential)
        printf 'unsafe git config (%s)' "$key"
        return 1
        ;;
      esac
    done <<<"$keys"
  done
  return 0
}

# Waits up to $1 seconds for a stale lock on the index to go away. Returns 0 when
# there is no lock.
wait_lock() {
  local gitdir n=$(($1 * 5))
  gitdir=$(g rev-parse --absolute-git-dir 2>/dev/null) || return 0
  while [ -e "$gitdir/index.lock" ] && [ "$n" -gt 0 ]; do
    sleep 0.2
    n=$((n - 1))
  done
  [ ! -e "$gitdir/index.lock" ]
}

# Prints the name of a merge, rebase, cherry-pick or revert in progress, if any.
in_progress() {
  local gitdir name
  gitdir=$(g rev-parse --absolute-git-dir 2>/dev/null) || return 0
  for name in MERGE_HEAD rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD; do
    if [ -e "$gitdir/$name" ]; then
      printf '%s' "$name"
      return 0
    fi
  done
}

# Runs a command in the background with a time limit, so that SIGTERM can stop it.
# $1 is the limit in seconds; a limit of 0 or less means no time is left, and the
# command does not run. Sets run_out and run_rc. run_out holds stdout and stderr,
# or only stderr when run_stdout names a file, which then gets stdout (NUL bytes
# kept). It runs in the current shell, not in a command substitution, so the trap
# can see inflight. A trapped signal makes wait return before the command ends, so
# wait runs again until the command is gone. timeout -k 2 sends SIGKILL when the
# command ignores SIGTERM.
inflight=""
run_out=""
run_rc=0
run_stdout=""
deadline=0
run() {
  local limit=$1 tmp
  shift
  if [ "$limit" -le 0 ]; then
    run_rc=124
    run_out="out of time"
    return
  fi
  tmp=$(mktemp)
  if [ -n "$run_stdout" ]; then
    timeout -k 2 "$limit" "$@" >"$run_stdout" 2>"$tmp" &
  else
    timeout -k 2 "$limit" "$@" >"$tmp" 2>&1 &
  fi
  inflight=$!
  wait "$inflight"
  run_rc=$?
  while kill -0 "$inflight" 2>/dev/null; do
    wait "$inflight"
    run_rc=$?
  done
  inflight=""
  run_out=$(cat "$tmp")
  rm -f "$tmp"
  case "$run_rc" in
  124 | 137) run_out="timed out after ${limit}s" ;;
  esac
}

# The limit for a step: $1 seconds, or what is left of the final budget if less.
step_limit() {
  local l=$1 r
  if [ "$deadline" -gt 0 ]; then
    r=$((deadline - SECONDS))
    [ "$r" -ge "$l" ] || l=$r
  fi
  echo "$l"
}

# True when the final budget is spent.
out_of_time() {
  [ "$deadline" -gt 0 ] && [ "$SECONDS" -ge "$deadline" ]
}

# Runs git with run_stdout set to a new temp file whose name goes to run_list.
# The caller removes the file.
run_listing() {
  local limit=$1
  shift
  run_list=$(mktemp)
  run_stdout=$run_list
  run "$limit" "$@"
  run_stdout=""
}

# Stages the changes for the WIP commit. Changes to files the index already tracks
# are staged with add -u, whatever their name, so an edit to a tracked .env.example
# is kept. Submodules are skipped. New files are staged with add -A minus
# exclude_specs. Then new files (absent from HEAD) that match secret_specs, which
# the agent may have staged itself, are removed from the index, and so are new or
# changed files over max_bytes. The work tree is never changed. Sets stage_err when
# a step fails or the final budget runs out, and stage_note to push-note lines
# naming what was kept out. File names from the work tree go to git with
# --literal-pathspecs, so a name like ":(glob)z.bin" is not read as pathspec magic.
stage() {
  local f rec secret_list="" secret_n=0
  local -a link_specs=()
  stage_err=""
  stage_note=""
  # git add checks each submodule in the index for changes by running "git status"
  # inside it, where the submodule's own config applies (a clean filter, for
  # example), and no flag turns that off for add. Submodule paths are therefore
  # left out of both add steps, so a changed submodule commit is not committed.
  run_listing "$(step_limit 30)" "$GIT" -C "$repo" "${git_flags[@]}" ls-files -s -z
  if [ "$run_rc" -ne 0 ]; then
    rm -f "$run_list"
    stage_err="listing the index failed: $run_out"
    return 1
  fi
  while IFS= read -r -d '' rec; do
    case "$rec" in
    "160000 "*) link_specs+=(":(exclude,literal)${rec#*$'\t'}") ;;
    esac
  done <"$run_list"
  rm -f "$run_list"
  run "$(step_limit 60)" "$GIT" -C "$repo" "${git_flags[@]}" add -u -- "${link_specs[@]}"
  if [ "$run_rc" -ne 0 ]; then
    stage_err=$run_out
    return 1
  fi
  run "$(step_limit 60)" "$GIT" -C "$repo" "${git_flags[@]}" add -A -- . "${exclude_specs[@]}" "${link_specs[@]}"
  if [ "$run_rc" -ne 0 ]; then
    stage_err=$run_out
    return 1
  fi

  # Without patterns there is nothing more to keep out. An empty pathspec list
  # would match every file.
  [ "${#secret_specs[@]}" -gt 0 ] || {
    check_sizes
    return
  }
  # New files with such a name that are not staged. Listed before the unstaging
  # below, so that no file is named twice. The repository's own ignore rules still
  # apply; only the image's exclude list is left out of this listing.
  run_listing "$(step_limit 10)" "$GIT" -C "$repo" "${git_flags[@]}" -c core.excludesFile=/dev/null \
    ls-files -z --others --exclude-standard -- "${secret_specs[@]}"
  if [ "$run_rc" -eq 0 ]; then
    while IFS= read -r -d '' f; do
      secret_n=$((secret_n + 1))
      [ "$secret_n" -gt 20 ] || secret_list="$secret_list $f"
    done <"$run_list"
  fi
  rm -f "$run_list"
  # Staged new files with such a name: removed from the index and named.
  run_listing "$(step_limit 30)" "$GIT" -C "$repo" "${git_flags[@]}" diff --cached --name-only -z --no-renames \
    --diff-filter=A --no-textconv --no-ext-diff -- "${secret_specs[@]}"
  if [ "$run_rc" -ne 0 ]; then
    rm -f "$run_list"
    stage_err="listing staged files failed: $run_out"
    return 1
  fi
  if [ -s "$run_list" ]; then
    run "$(step_limit 30)" "$GIT" --literal-pathspecs -C "$repo" "${git_flags[@]}" rm -q --cached -f \
      --pathspec-from-file="$run_list" --pathspec-file-nul
    if [ "$run_rc" -ne 0 ]; then
      rm -f "$run_list"
      stage_err="unstaging files with secret-like names failed: $run_out"
      return 1
    fi
    while IFS= read -r -d '' f; do
      secret_n=$((secret_n + 1))
      [ "$secret_n" -gt 20 ] || secret_list="$secret_list $f"
    done <"$run_list"
  fi
  rm -f "$run_list"
  if [ "$secret_n" -gt 0 ]; then
    stage_note="push-note: kept $secret_n new file(s) with secret-like names out of the commit:$secret_list"
  fi
  check_sizes
}

# Removes new or changed files over max_bytes from the index, and adds a note that
# names them to stage_note. Sets stage_err and returns 1 when a step fails or the
# final budget runs out.
check_sizes() {
  local f size list="" skipped=0
  run_listing "$(step_limit 30)" "$GIT" -C "$repo" "${git_flags[@]}" diff --cached --name-only -z \
    --diff-filter=AM --no-textconv --no-ext-diff
  if [ "$run_rc" -ne 0 ]; then
    rm -f "$run_list"
    stage_err="listing staged files failed: $run_out"
    return 1
  fi
  while IFS= read -r -d '' f; do
    if out_of_time; then
      stage_err="out of time while checking file sizes"
      break
    fi
    size=$(stat -c %s "$repo/$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$max_bytes" ]; then
      run "$(step_limit 10)" "$GIT" --literal-pathspecs -C "$repo" "${git_flags[@]}" reset -q -- "$f"
      if [ "$run_rc" -ne 0 ]; then
        stage_err="unstaging $f failed: $run_out"
        break
      fi
      skipped=$((skipped + 1))
      [ "$skipped" -gt 20 ] || list="$list $f"
    fi
  done <"$run_list"
  rm -f "$run_list"
  [ -z "$stage_err" ] || return 1
  if [ "$skipped" -gt 0 ]; then
    stage_note="${stage_note:+$stage_note
}push-note: skipped $skipped file(s) over 10 MB:$list"
  fi
  return 0
}

stop=0
final=0
killed=0
sleeper=""
# shellcheck disable=SC2329 # called through the trap below
on_term() {
  stop=1
  [ -z "$sleeper" ] || kill "$sleeper" 2>/dev/null
  # A periodic push or commit step in flight is stopped so the final path can run
  # inside the grace period. During the final path the signal changes nothing.
  if [ "$final" -eq 0 ] && [ -n "$inflight" ]; then
    killed=1
    kill "$inflight" 2>/dev/null
  fi
}
trap on_term TERM INT

# Sleeps $1 seconds in the background, so that SIGTERM ends the sleep at once.
# A signal that arrives before sleeper is set finds no sleeper to kill, so stop is
# checked again before the wait.
pause() {
  sleep "$1" &
  sleeper=$!
  [ "$stop" -eq 0 ] || kill "$sleeper" 2>/dev/null
  wait "$sleeper" 2>/dev/null
  sleeper=""
}

# Commits the working tree changes. $1 is the lock wait in seconds. Sets commit_note
# (why the changes were not committed, or empty) and commit_done (1 when a commit
# was made). Returns 2 when SIGTERM stopped a step.
commit_changes() {
  local op status
  commit_note=""
  commit_done=0
  op=$(in_progress)
  if [ -n "$op" ]; then
    printf 'push-note: %s in progress, not committing; pushing HEAD only\n' "$op"
    return 0
  fi
  if ! wait_lock "$(step_limit "$1")"; then
    commit_note="commit skipped, index.lock exists; "
    return 0
  fi
  run "$(step_limit 60)" "$GIT" -C "$repo" "${git_flags[@]}" status --porcelain --ignore-submodules=dirty
  [ "$killed" -eq 0 ] || return 2
  if [ "$run_rc" -ne 0 ]; then
    commit_note="status failed: $(clean "$run_out"); "
    return 0
  fi
  status=$run_out
  [ -n "$status" ] || return 0
  if ! stage; then
    [ "$killed" -eq 0 ] || return 2
    commit_note="commit failed: $(clean "$stage_err"); "
    return 0
  fi
  [ "$killed" -eq 0 ] || return 2
  [ -z "$stage_note" ] || printf '%s\n' "$stage_note"
  run "$(step_limit 30)" "$GIT" -C "$repo" "${git_flags[@]}" diff --cached --quiet --no-textconv --no-ext-diff
  [ "$killed" -eq 0 ] || return 2
  case "$run_rc" in
  0) return 0 ;;
  1) ;;
  *)
    commit_note="commit failed: $(clean "$run_out"); "
    return 0
    ;;
  esac
  run "$(step_limit 60)" "$GIT" -C "$repo" "${git_flags[@]}" commit -q --no-verify -m "agent WIP"
  [ "$killed" -eq 0 ] || return 2
  if [ "$run_rc" -eq 0 ]; then
    commit_done=1
  else
    commit_note="commit failed: $(clean "$run_out"); "
  fi
  return 0
}

# Pushes HEAD to the branch at PUSH_URL, within $1 seconds. Sets push_rc and
# push_reason. Returns 2 when SIGTERM stopped the push.
push_head() {
  run "$1" "$GIT" -C "$repo" "${git_flags[@]}" push --no-recurse-submodules "$url" "HEAD:refs/heads/$branch"
  [ "$killed" -eq 0 ] || return 2
  push_rc=$run_rc
  push_reason=$(clean "$run_out")
  return 0
}

# Periodic attempt: commit, then push. Prints one result line. Returns 0 on push-ok,
# 1 on push-failed and 2 when SIGTERM stopped the attempt.
push_now() {
  local bad
  if ! bad=$(check_config); then
    printf 'push-failed: %s\n' "$bad"
    return 1
  fi
  commit_changes 3 || return 2
  push_head 120 || return 2
  if [ "$push_rc" -eq 0 ]; then
    if [ -n "$commit_note" ]; then
      printf 'push-failed: %sHEAD was pushed, the working tree changes were not\n' "$commit_note"
      return 1
    fi
    echo push-ok
    return 0
  fi
  printf 'push-failed: %s%s\n' "$commit_note" "$push_reason"
  return 1
}

# The final path after SIGTERM, with a 20 s budget for every step together. Pushes
# HEAD first (10 s at most), then commits the remaining changes and pushes again
# with the time left. Prints one result line and returns 0 or 1.
final_push() {
  local bad head_rc head_reason
  final=1
  killed=0
  deadline=$((SECONDS + 20))
  if ! bad=$(check_config); then
    printf 'push-failed: %s\n' "$bad"
    return 1
  fi
  push_head "$(step_limit 10)"
  head_rc=$push_rc
  head_reason=$push_reason
  if [ "$head_rc" -eq 0 ]; then
    echo "push-note: HEAD pushed"
  else
    printf 'push-note: pushing HEAD failed: %s\n' "$head_reason"
  fi
  commit_changes 1
  if [ "$commit_done" -eq 1 ]; then
    push_head "$(step_limit 20)"
    if [ "$push_rc" -eq 0 ]; then
      echo push-ok
      return 0
    fi
    printf 'push-failed: %s\n' "$push_reason"
    return 1
  fi
  if [ "$head_rc" -eq 0 ]; then
    if [ -n "$commit_note" ]; then
      printf 'push-failed: %sHEAD was pushed, the working tree changes were not\n' "$commit_note"
      return 1
    fi
    echo push-ok
    return 0
  fi
  printf 'push-failed: %s%s\n' "$commit_note" "$head_reason"
  return 1
}

# Wait for the repository. A stop request before it exists is a failure: nothing
# was cloned, so nothing can be pushed.
announced=0
until [ "$stop" -eq 1 ] || g rev-parse --git-dir >/dev/null 2>&1; do
  if [ "$announced" -eq 0 ]; then
    echo "waiting for a git repository at $repo"
    announced=1
  fi
  pause 2
done
if [ "$stop" -eq 1 ] && ! g rev-parse --git-dir >/dev/null 2>&1; then
  fail "no git repository at $repo"
fi

while [ "$stop" -eq 0 ]; do
  pause "$interval"
  [ "$stop" -eq 0 ] || break
  push_now
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "push-note: stopped by SIGTERM during a periodic push, running the final push"
  fi
done

final_push
exit $?
