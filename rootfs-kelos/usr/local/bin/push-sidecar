#!/bin/bash -p
# Pushes the agent's work to a branch while a Kelos Task runs, and once more when
# the pod is told to stop. It runs as a sidecar (an init container with
# restartPolicy: Always) next to the agent, so the work survives a deadline kill.
#
# Environment:
#   PUSH_URL                https://github.com/<owner>/<repo>.git, the push target (required)
#   PUSH_BRANCH             branch to push to (required)
#   KELOS_GITHUB_TOKEN_FILE file that holds the GitHub token (required)
#   PUSH_REPO               repository directory (default /workspace/repo)
#   PUSH_INTERVAL           seconds between pushes (default 900)
#   PUSH_ALLOW_FILE_REMOTE  set to 1 to accept an absolute local path as PUSH_URL (tests)
#   GIT_AUTHOR_NAME, GIT_AUTHOR_EMAIL, GIT_COMMITTER_NAME, GIT_COMMITTER_EMAIL
#                           commit identity; the committer falls back to the author
#   HTTPS_PROXY, https_proxy, GIT_SSL_CAINFO
#                           read by git as usual
#
# Every push attempt prints "push-ok" or "push-failed: <reason>". Other lines start
# with "push-note:". The exit status is that of the final push after SIGTERM: 0 for
# push-ok, 1 for push-failed.
#
# Known limit: the sidecar pushes HEAD, so commits the agent made itself go out as
# they are, including secrets, files over 10 MB and conflict markers. The exclude
# list and the size cap apply only to the sidecar's own "agent WIP" commit. A rule
# on the remote side (push protection, a size limit) is the only guard for those.
#
# Threat model: the repository content comes from the agent, so repo-level git
# config must not start commands or redirect the token. The agent already holds the
# same token (Kelos sets GITHUB_TOKEN and KELOS_GITHUB_TOKEN_FILE in the agent
# container), so this guards against the repository, not against the agent.
#
# Shutdown time: after the agent exits, the kubelet sends SIGTERM to the sidecar
# and the pod's termination grace period (30 s unless the pod sets another value)
# is all it has. Kelos v0.62.0 cannot set terminationGracePeriodSeconds on a Task
# pod. The final path therefore has a total budget of 20 s from the signal, and
# every step in it (push, status, add, commit) is killed when the budget runs out.
# It first pushes HEAD as it is, with at most 10 s, so the agent's own commits go
# out. It then commits the working tree changes and pushes again with whatever
# time is left. A periodic push or commit in flight is killed when SIGTERM arrives.
set -uo pipefail

repo=${PUSH_REPO:-/workspace/repo}
interval=${PUSH_INTERVAL:-900}
url=${PUSH_URL:-}
branch=${PUSH_BRANCH:-}
token_file=${KELOS_GITHUB_TOKEN_FILE:-}
GIT=/usr/bin/git
excludes=/usr/local/share/push-sidecar/excludes
max_bytes=$((10 * 1024 * 1024))
# The excludes file also feeds pathspec excludes on git add. A negation in
# .gitignore or .git/info/exclude (!.env) can override core.excludesFile but not a
# pathspec, so these keep the listed names, and everything under a directory with
# such a name, out of the commit.
exclude_specs=()
if [ -r "$excludes" ]; then
  while IFS= read -r pattern; do
    case "$pattern" in '' | '#'*) continue ;; esac
    exclude_specs+=(":(exclude,glob)**/$pattern" ":(exclude,glob)**/$pattern/**")
  done <"$excludes"
fi

fail() {
  printf 'push-failed: %s\n' "$1"
  exit 1
}

[ -n "$url" ] || fail "PUSH_URL is not set"
if [ "${PUSH_ALLOW_FILE_REMOTE:-}" = 1 ]; then
  case "$url" in
  https://github.com/* | /*) ;;
  *) fail "PUSH_URL must be an https://github.com/<owner>/<repo>.git URL" ;;
  esac
  case "$url" in
  /*) ;;
  *) [[ $url =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fail "PUSH_URL must be an https://github.com/<owner>/<repo>.git URL" ;;
  esac
else
  [[ $url =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fail "PUSH_URL must be an https://github.com/<owner>/<repo>.git URL"
fi
[ -n "$branch" ] || fail "PUSH_BRANCH is not set"
case "$branch" in
-* | */ | *..* | *[[:space:]]*) fail "PUSH_BRANCH is not a valid branch name" ;;
esac
"$GIT" check-ref-format --branch "$branch" >/dev/null 2>&1 || fail "PUSH_BRANCH is not a valid branch name"
[ -n "$token_file" ] || fail "KELOS_GITHUB_TOKEN_FILE is not set"
[ -s "$token_file" ] && [ -r "$token_file" ] || fail "token file $token_file is missing, empty or unreadable"
case "$interval" in
'' | *[!0-9]* | 0) fail "PUSH_INTERVAL must be a positive number of seconds" ;;
esac

# The identity comes from the Task's environment. Git reads the author variables
# itself; the committer falls back to the author.
: "${GIT_COMMITTER_NAME:=${GIT_AUTHOR_NAME:-}}"
: "${GIT_COMMITTER_EMAIL:=${GIT_AUTHOR_EMAIL:-}}"
[ -z "$GIT_COMMITTER_NAME" ] || export GIT_COMMITTER_NAME
[ -z "$GIT_COMMITTER_EMAIL" ] || export GIT_COMMITTER_EMAIL

# Ignore the user and system git config, and prompts.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_TERMINAL_PROMPT=0
export HOME=${HOME:-/home/kelos}

# The credential helper reads the token file when git asks, so the token is never
# on a command line or in a URL. It is registered for https://github.com only, and
# the empty credential.helper entry clears every helper the repository config lists.
# shellcheck disable=SC2016 # the helper runs in a shell that expands it
helper='!f() { echo username=x-access-token; echo "password=$(cat "$KELOS_GITHUB_TOKEN_FILE")"; }; f'

# Flags that stop repository config from starting a command or changing where the
# token goes. Keys that cannot be switched off by a flag are refused in
# check_config. protocol.* allows https only (and a local path in tests).
git_flags=(
  -c core.hooksPath=/dev/null
  -c core.fsmonitor=false
  -c core.sshCommand=false
  -c core.askPass=false
  -c commit.gpgsign=false
  -c tag.gpgsign=false
  -c protocol.allow=never
  -c protocol.https.allow=always
  -c http.sslVerify=true
  -c "core.excludesFile=$excludes"
  -c "safe.directory=$repo"
  -c credential.helper=
  -c "credential.https://github.com.helper=$helper"
)
if [ "${PUSH_ALLOW_FILE_REMOTE:-}" = 1 ]; then
  git_flags+=(-c protocol.file.allow=always)
fi
if [ -n "${GIT_SSL_CAINFO:-}" ]; then
  git_flags+=(-c "http.sslCAInfo=$GIT_SSL_CAINFO")
fi
g() {
  "$GIT" -C "$repo" "${git_flags[@]}" "$@"
}
# Same, with file names read literally. Used wherever a file name from the work tree
# is passed as a pathspec, so a name like ":(glob)z.bin" is not read as pathspec magic.
gl() {
  "$GIT" --literal-pathspecs -C "$repo" "${git_flags[@]}" "$@"
}

# One line, at most 400 characters, with the token removed.
clean() {
  local text=$1 tok
  tok=$(cat "$token_file" 2>/dev/null || true)
  if [ -n "$tok" ]; then
    text=${text//"$tok"/***}
  fi
  text=$(printf '%s' "$text" | tr '\n' ' ' | tr -s ' ')
  printf '%s' "${text:0:400}"
}

# Refuses a repository whose config could start a command or move the token:
#   include.*, includeIf.*   pull in config from files the agent can write
#   filter.*                 clean and smudge drivers run commands during git add
#   core.fsmonitor           a command that runs during status and add
#   core.sshCommand          a command that runs for ssh remotes
#   core.hooksPath           hooks directory
#   core.askPass, core.gitProxy, core.worktree  commands or a moved work tree
#   diff.*                   textconv and external diff drivers run commands
#   push.*, submodule.*      push.recurseSubmodules and submodule.recurse make a push
#                            follow submodules, whose own config this check never reads
#   remote.*                 pushurl, proxy and similar keys, also keyed by URL,
#                            redirect the push; only remote.origin.url and
#                            remote.origin.fetch pass (what git clone and Kelos write)
#   gpg.*                    a signing program that commit would run
#   url.*                    insteadOf and pushInsteadOf rewrite the push URL
#   http.*                   proxy, CA file, TLS verification and extra headers
#   protocol.*               which transports are allowed
#   credential.*             all except credential.helper and credential.username,
#                            which Kelos writes itself; the flags above clear them
# The keys are read with git config --file, which does not follow includes and runs
# nothing.
check_config() {
  local common gitdir f key
  common=$("$GIT" -C "$repo" rev-parse --git-common-dir 2>/dev/null) || return 0
  gitdir=$("$GIT" -C "$repo" rev-parse --git-dir 2>/dev/null) || return 0
  for f in "$repo/$common/config" "$repo/$gitdir/config.worktree" "$common/config" "$gitdir/config.worktree"; do
    [ -f "$f" ] || continue
    while IFS= read -r key; do
      key=${key,,}
      case "$key" in
      credential.helper | credential.username | remote.origin.url | remote.origin.fetch) ;;
      remote.* | diff.* | push.* | submodule.* | include.* | includeif.* | filter.* | core.fsmonitor | core.sshcommand | core.hookspath | core.askpass | core.gitproxy | core.worktree | gpg.* | url.* | http.* | protocol.* | credential.* | credential)
        printf '%s' "$key"
        return 1
        ;;
      esac
    done < <("$GIT" config --file "$f" --list --name-only 2>/dev/null)
  done
  return 0
}

# Waits up to $1 seconds for a stale lock on the index to go away. Returns 0 when
# there is no lock.
wait_lock() {
  local gitdir n=$(($1 * 5))
  gitdir=$(cd "$repo" && "$GIT" rev-parse --absolute-git-dir 2>/dev/null) || return 0
  while [ -e "$gitdir/index.lock" ] && [ "$n" -gt 0 ]; do
    sleep 0.2
    n=$((n - 1))
  done
  [ ! -e "$gitdir/index.lock" ]
}

# Prints the name of a merge, rebase, cherry-pick or revert in progress, if any.
in_progress() {
  local gitdir name
  gitdir=$(cd "$repo" && "$GIT" rev-parse --absolute-git-dir 2>/dev/null) || return 0
  for name in MERGE_HEAD rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD; do
    if [ -e "$gitdir/$name" ]; then
      printf '%s' "$name"
      return 0
    fi
  done
}

# Runs a command in the background with a time limit, so that SIGTERM can stop it.
# $1 is the limit in seconds; a limit of 0 or less means no time is left, and the
# command does not run. Sets run_out (combined output) and run_rc. It runs in the
# current shell, not in a command substitution, so the trap can see inflight.
inflight=""
run_out=""
run_rc=0
deadline=0
run() {
  local limit=$1 tmp
  shift
  if [ "$limit" -le 0 ]; then
    run_rc=124
    run_out="out of time"
    return
  fi
  tmp=$(mktemp)
  timeout "$limit" "$@" >"$tmp" 2>&1 &
  inflight=$!
  wait "$inflight"
  run_rc=$?
  inflight=""
  run_out=$(cat "$tmp")
  rm -f "$tmp"
  [ "$run_rc" -ne 124 ] || run_out="timed out after ${limit}s"
}

# The limit for a step: $1 seconds, or what is left of the final budget if less.
step_limit() {
  local l=$1 r
  if [ "$deadline" -gt 0 ]; then
    r=$((deadline - SECONDS))
    [ "$r" -ge "$l" ] || l=$r
  fi
  echo "$l"
}

# Stages changes except the excluded names and files over max_bytes. Sets stage_err
# when git add fails and stage_note to a line naming the skipped files.
stage() {
  local f size n=0 list="" skipped=0
  stage_err=""
  stage_note=""
  run "$(step_limit 60)" "$GIT" -C "$repo" "${git_flags[@]}" add -A -- . "${exclude_specs[@]}"
  if [ "$run_rc" -ne 0 ]; then
    stage_err=$run_out
    return 1
  fi
  while IFS= read -r -d '' f; do
    size=$(stat -c %s "$repo/$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$max_bytes" ]; then
      gl reset -q -- "$f" >/dev/null 2>&1
      skipped=$((skipped + 1))
      n=$((n + 1))
      [ "$n" -gt 20 ] || list="$list $f"
    fi
  done < <(g diff --cached --name-only -z --diff-filter=AM --no-textconv --no-ext-diff 2>/dev/null)
  if [ "$skipped" -gt 0 ]; then
    stage_note="push-note: skipped $skipped file(s) over 10 MB:$list"
  fi
  return 0
}

stop=0
final=0
killed=0
sleeper=""
# shellcheck disable=SC2329 # called through the trap below
on_term() {
  stop=1
  [ -z "$sleeper" ] || kill "$sleeper" 2>/dev/null
  # A periodic push or commit step in flight is stopped so the final path can run
  # inside the grace period. During the final path the signal changes nothing.
  if [ "$final" -eq 0 ] && [ -n "$inflight" ]; then
    killed=1
    kill "$inflight" 2>/dev/null
  fi
}
trap on_term TERM INT

# Commits the working tree changes. $1 is the lock wait in seconds. Sets commit_note
# (why nothing was committed, or empty) and commit_done (1 when a commit was made).
# Returns 2 when SIGTERM stopped a step.
commit_changes() {
  local op status
  commit_note=""
  commit_done=0
  op=$(in_progress)
  if [ -n "$op" ]; then
    printf 'push-note: %s in progress, not committing; pushing HEAD only\n' "$op"
    return 0
  fi
  if ! wait_lock "$(step_limit "$1")"; then
    commit_note="commit skipped, index.lock exists; "
    return 0
  fi
  run "$(step_limit 60)" "$GIT" -C "$repo" "${git_flags[@]}" status --porcelain
  [ "$killed" -eq 0 ] || return 2
  status=$run_out
  [ "$run_rc" -eq 0 ] && [ -n "$status" ] || return 0
  if ! stage; then
    [ "$killed" -eq 0 ] || return 2
    commit_note="commit failed: $(clean "$stage_err"); "
    return 0
  fi
  [ "$killed" -eq 0 ] || return 2
  [ -z "$stage_note" ] || printf '%s\n' "$stage_note"
  if g diff --cached --quiet --no-textconv --no-ext-diff 2>/dev/null; then
    return 0
  fi
  run "$(step_limit 60)" "$GIT" -C "$repo" "${git_flags[@]}" commit -q --no-verify -m "agent WIP"
  [ "$killed" -eq 0 ] || return 2
  if [ "$run_rc" -eq 0 ]; then
    commit_done=1
  else
    commit_note="commit failed: $(clean "$run_out"); "
  fi
  return 0
}

# Pushes HEAD to the branch at PUSH_URL, within $1 seconds. Sets push_rc and
# push_reason. Returns 2 when SIGTERM stopped the push.
push_head() {
  run "$1" "$GIT" -C "$repo" "${git_flags[@]}" push --no-recurse-submodules "$url" "HEAD:refs/heads/$branch"
  [ "$killed" -eq 0 ] || return 2
  push_rc=$run_rc
  push_reason=$(clean "$run_out")
  return 0
}

# Periodic attempt: commit, then push. Prints one result line. Returns 0 on push-ok,
# 1 on push-failed and 2 when SIGTERM stopped the attempt.
push_now() {
  local bad
  if bad=$(check_config); then
    :
  else
    printf 'push-failed: unsafe git config (%s)\n' "$bad"
    return 1
  fi
  commit_changes 3 || return 2
  push_head 120 || return 2
  if [ "$push_rc" -eq 0 ]; then
    if [ -n "$commit_note" ]; then
      printf 'push-failed: %sHEAD was pushed, the working tree changes were not\n' "$commit_note"
      return 1
    fi
    echo push-ok
    return 0
  fi
  printf 'push-failed: %s%s\n' "$commit_note" "$push_reason"
  return 1
}

# The final path after SIGTERM, with a 20 s budget for every step together. Pushes
# HEAD first (10 s at most), then commits the remaining changes and pushes again
# with the time left. Prints one result line and returns 0 or 1.
final_push() {
  local bad head_rc head_reason
  final=1
  killed=0
  deadline=$((SECONDS + 20))
  if bad=$(check_config); then
    :
  else
    printf 'push-failed: unsafe git config (%s)\n' "$bad"
    return 1
  fi
  push_head "$(step_limit 10)"
  head_rc=$push_rc
  head_reason=$push_reason
  if [ "$head_rc" -eq 0 ]; then
    echo "push-note: HEAD pushed"
  else
    printf 'push-note: pushing HEAD failed: %s\n' "$head_reason"
  fi
  commit_changes 1
  if [ "$commit_done" -eq 1 ]; then
    push_head "$(step_limit 20)"
    if [ "$push_rc" -eq 0 ]; then
      echo push-ok
      return 0
    fi
    printf 'push-failed: %s\n' "$push_reason"
    return 1
  fi
  if [ "$head_rc" -eq 0 ]; then
    if [ -n "$commit_note" ]; then
      printf 'push-failed: %sHEAD was pushed, the working tree changes were not\n' "$commit_note"
      return 1
    fi
    echo push-ok
    return 0
  fi
  printf 'push-failed: %s%s\n' "$commit_note" "$head_reason"
  return 1
}

# Wait for the repository. A stop request before it exists is a failure: nothing
# was cloned, so nothing can be pushed.
announced=0
until [ "$stop" -eq 1 ] || "$GIT" -C "$repo" rev-parse --git-dir >/dev/null 2>&1; do
  if [ "$announced" -eq 0 ]; then
    echo "waiting for a git repository at $repo"
    announced=1
  fi
  sleep 2 &
  sleeper=$!
  wait "$sleeper" 2>/dev/null
  sleeper=""
done
if [ "$stop" -eq 1 ] && ! "$GIT" -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
  fail "no git repository at $repo"
fi

while [ "$stop" -eq 0 ]; do
  sleep "$interval" &
  sleeper=$!
  wait "$sleeper" 2>/dev/null
  sleeper=""
  [ "$stop" -eq 0 ] || break
  push_now
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "push-note: stopped by SIGTERM during a periodic push, running the final push"
  fi
done

final_push
exit $?
