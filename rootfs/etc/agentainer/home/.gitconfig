# Generic Agentainer Git defaults.
# Reference: https://git-scm.com/docs/git-config
[core]
    editor = vim
    excludesFile = ~/.config/git/ignore
    pager = less -FRSX
[color]
    ui = auto
# GitHub Dark colors. Palette sources: https://github.com/primer/primitives (@primer/primitives 11.10.0) and the maintainer's github-dark.terminal. Git emits them only when color.ui or the command enables color.
[color "diff"]
    context = "#e6edf3"
    meta = "#58a6ff" bold
    frag = "#d2a8ff"
    old = "#ff7b72"
    new = "#3fb950"
    whitespace = normal "#ff7b72"
[color "status"]
    added = "#3fb950"
    changed = "#d29922"
    untracked = "#ffa657"
    unmerged = "#ff7b72" bold
    branch = "#58a6ff"
[color "branch"]
    current = "#58a6ff" bold
    local = "#e6edf3"
    remote = "#39c5cf"
[color "decorate"]
    branch = "#58a6ff" bold
    remoteBranch = "#39c5cf"
    tag = "#d2a8ff"
[init]
    defaultBranch = main
[user]
    useConfigOnly = true
    # name = Your Name
    # email = you@example.com
    # signingKey = YOUR_GPG_KEY_FINGERPRINT

# Make your GPG signing key available before enabling signing.
#[gpg]
#    format = openpgp
#[commit]
#    gpgSign = true
#[tag]
#    gpgSign = true

[alias]
    br = branch
    co = checkout
    ci = commit
    st = status
    df = diff
    summary = log --oneline
    graph = log --graph --oneline --decorate
    changes = log --oneline --reverse
    lg = "log --graph --abbrev-commit --decorate --format=format:'%C(bold #d29922)%h%C(reset) - %C(#58a6ff)(%ar)%C(reset) %C(#e6edf3)%s%C(reset) %C(#9198a1)- %an%C(reset)%C(auto)%d%C(reset)'"

[push]
    default = simple
