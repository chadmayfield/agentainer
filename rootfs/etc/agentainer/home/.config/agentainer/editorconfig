# Project template. Copy to a project's .editorconfig only when it has none.
# Specification and precedence: https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,js,ts,html,css}]
indent_size = 2

[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
indent_size = tab
