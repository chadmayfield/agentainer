{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "ayu",
    "mode": "dark"
  },
  "attention": {
    "notifications": true,
    "sound": false
  },
  "session": {
    "permissions": "prompt"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word",
    "tree": true
  },
  "mini": {
    "footer": "show",
    "turn_summary": "show"
  }
}
