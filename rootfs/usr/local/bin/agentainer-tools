#!/bin/sh
# agentainer-tools status|reset (spec section 10)
set -eu
# shellcheck source=rootfs/usr/local/lib/agentainer/tools-layout.sh
. /usr/local/lib/agentainer/tools-layout.sh
active=/var/lib/agentainer/active
case "${1:-status}" in
status)
	printf 'mode: %s\nroot: %s\n' "${AGENTAINER_TOOLS:-ephemeral}" "$(readlink "$active" 2>/dev/null || echo none)"
	ls "$active/bin" "$active/npm/bin" 2>/dev/null || true
	;;
reset)
	dir="$HOME/.agentainer/tools"
	if [ -d "$dir" ]; then
		dest="$dir.$(date -u +%Y%m%dT%H%M%SZ).$$.bak"
		mv "$dir" "$dest"
		tools_mkdirs "$dir"
		rm -f "$HOME/.agentainer/tools-image-version"
		echo "moved $dir to $dest"
	else
		echo "no persisted tools"
	fi
	;;
*)
	echo "usage: agentainer-tools status|reset" >&2
	exit 2
	;;
esac
