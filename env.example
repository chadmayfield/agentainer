# Copy to ~/.config/agentainer/env and chmod 600. Uncomment only what you use:
# an empty value still counts as set (git, for one, refuses an empty GIT_AUTHOR_NAME).
# Every variable here is readable by every process in the container.

# Claude Code: one of these, or log in with /login inside the container.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Codex: after setting the key, run printenv OPENAI_API_KEY | codex login --with-api-key
# Or log in with codex login --device-auth.
# OPENAI_API_KEY=

# Antigravity API-key mode (also set "modelProvider": "gemini" in its settings)
# GEMINI_API_KEY=

# OpenRouter: used by openrouter-claude, openrouter-codex and OpenCode
# OPENROUTER_API_KEY=

# GitHub: a fine-grained token scoped to the repos the agents may push to
# GH_TOKEN=
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=

# ephemeral (default) or persist
# AGENTAINER_TOOLS=persist
