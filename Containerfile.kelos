# Kelos variant of the Agentainer image. Build with scripts/build.sh --variant kelos.
# Kelos runs its agent containers as UID 61100 and starts them with
# /kelos_entrypoint.sh. This image adds the Kelos entrypoints, the kelos-capture
# binary and the gh wrapper to the Agentainer image. Nothing is installed at
# startup. Source and changes: rootfs-kelos/SOURCE.md.
#
# Agentainer already has what Kelos's claude-code and codex Dockerfiles install
# (git, make, curl, ca-certificates, tini, Node.js, gh, Go, bubblewrap), so this
# file adds no packages.
#
# The four ARG lines below are the variant's pins. scripts/bump_versions.py (r_kelos)
# rewrites them in the scheduled update, so keep each on one line in this form:
#   AGENTAINER_IMAGE       the newest published Agentainer release, by tag and index
#                          digest (scripts/build.sh --from overrides it)
#   GOLANG_IMAGE           the official golang image for the newest stable Go, by tag
#                          and index digest
#   KELOS_FORK_COMMIT      the commit of the newest v<version>-rest.<n> tag of the
#                          kelos-capture fork
#   KELOS_CAPTURE_VERSION  that tag's name, which the binary reports as its version
ARG AGENTAINER_IMAGE=ghcr.io/chadmayfield/agentainer:0.1.0-dev.20261104.1@sha256:9cf7377a12d0ebf5b82ddd742b05c412f4400979e1a687b632f31bcba6fb3f7c
ARG GOLANG_IMAGE=docker.io/library/golang:1.27.4@sha256:5f1b98fa02fe396ebce2a0227a0e08309e11792915b9dd2e1f71053d7e7e6666
ARG KELOS_FORK_COMMIT=958eadc39f5b0fe248059b719f584fcf006d02e2
ARG KELOS_CAPTURE_VERSION=v0.65.0-rest.1

# Builds kelos-capture from source, from the fork at github.com/chadmayfield/kelos.
# Each v<version>-rest.<n> tag there is upstream kelos-dev/kelos at release
# v<version> plus one commit that makes kelos-capture list pull requests over the
# GitHub REST API (gh api repos/<owner>/<repo>/pulls) instead of gh pr list, which
# uses GraphQL. Some HTTP egress proxies allow the REST API and block GraphQL. To
# use the upstream code instead, point the remote below at
# https://github.com/kelos-dev/kelos.git and set KELOS_FORK_COMMIT and
# KELOS_CAPTURE_VERSION to an upstream release tag's commit and name.
#
# The stage runs on the build host's architecture and cross-compiles (CGO off), so
# it does not need emulation. The official golang image sets GOTOOLCHAIN=local, so
# the Go in GOLANG_IMAGE must satisfy the go line of the fork's go.mod; r_kelos
# checks that before it writes a pin. The build needs network access to github.com
# and the Go module proxy. The flags match Kelos's Makefile (CGO_ENABLED=0, version
# ldflags), plus -trimpath so the binary does not record the build directory.
FROM --platform=$BUILDPLATFORM ${GOLANG_IMAGE} AS kelos-capture
ARG TARGETARCH
ARG KELOS_FORK_COMMIT
ARG KELOS_CAPTURE_VERSION
RUN git init -q /src \
	&& cd /src \
	&& git remote add origin https://github.com/chadmayfield/kelos.git \
	&& git fetch -q --depth 1 origin "${KELOS_FORK_COMMIT}" \
	&& git checkout -q FETCH_HEAD \
	&& test "$(git rev-parse HEAD)" = "${KELOS_FORK_COMMIT}" \
	&& CGO_ENABLED=0 GOOS=linux GOARCH="${TARGETARCH}" go build -trimpath \
		-ldflags "-X github.com/kelos-dev/kelos/internal/version.Version=${KELOS_CAPTURE_VERSION}" \
		-o /out/kelos-capture ./cmd/kelos-capture

FROM ${AGENTAINER_IMAGE}

ARG TARGETARCH
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
USER root

# The Kelos gh wrapper ends with exec /usr/bin/gh, so the real gh moves there and
# the wrapper takes its place in /usr/local/bin.
RUN mv /usr/local/bin/gh /usr/bin/gh

COPY --chmod=0755 rootfs-kelos/kelos_entrypoint.sh \
	rootfs-kelos/kelos_entrypoint_claude.sh \
	rootfs-kelos/kelos_entrypoint_codex.sh /
COPY --chmod=0755 rootfs-kelos/agent-gh-wrapper.sh /usr/local/bin/gh
# The push sidecar runs in its own container of the Task pod (an init container with
# restartPolicy: Always) and pushes the agent's work to a branch.
COPY --chmod=0755 rootfs-kelos/usr/local/bin/push-sidecar /usr/local/bin/push-sidecar
COPY --chmod=0644 rootfs-kelos/usr/local/share/push-sidecar/excludes /usr/local/share/push-sidecar/excludes
# The guard is sourced by the dispatcher and by the claude wrapper. The wrapper sits
# first on PATH while the dispatcher runs the Kelos entrypoint, so the guard runs
# once more right before the real claude starts.
COPY --chmod=0644 rootfs-kelos/kelos_guard.sh /usr/local/lib/kelos/guard.sh
COPY --chmod=0755 rootfs-kelos/claude-wrapper.sh /usr/local/lib/kelos/bin/claude
# Claude's headersHelper for the MCP gateway: prints the bearer header from the
# token file mounted at /etc/agentainer/mcp/token.
COPY --chmod=0755 rootfs-kelos/mcp-headers.sh /usr/local/lib/kelos/mcp-headers
# kelos-capture comes from the builder stage above, not from a Kelos release binary.
# Provenance: rootfs-kelos/SOURCE.md.
COPY --from=kelos-capture --chmod=0755 /out/kelos-capture /kelos/kelos-capture
COPY --chmod=0644 rootfs-kelos/LICENSE.kelos rootfs-kelos/SOURCE.md /usr/share/doc/kelos/

RUN useradd -u 61100 -m -s /bin/bash kelos \
	&& install -d -o kelos -g kelos /home/kelos/.claude /home/kelos/.codex /home/kelos/.local/bin /home/kelos/go

# The Agentainer entrypoint points /var/lib/agentainer/active at a tools root. It
# does not run here, so the tool locations move into the home directory.
ENV GOPATH=/home/kelos/go \
	GOBIN=/home/kelos/.local/bin \
	NPM_CONFIG_PREFIX=/home/kelos/.local \
	CARGO_HOME=/home/kelos/.cargo \
	CARGO_INSTALL_ROOT=/home/kelos/.local \
	UV_TOOL_DIR=/home/kelos/.local/share/uv/tools \
	UV_TOOL_BIN_DIR=/home/kelos/.local/bin \
	PIPX_HOME=/home/kelos/.local/pipx \
	PIPX_BIN_DIR=/home/kelos/.local/bin \
	PYTHONUSERBASE=/home/kelos/.local \
	PATH=/home/kelos/.local/bin:/usr/local/go/bin:/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The labels describe this image, not the Agentainer image it is built on, whose
# labels it would otherwise inherit. scripts/build.sh passes the values.
ARG IMAGE_VERSION=dev
ARG VCS_REF=unknown
ARG BUILD_DATE
ARG AGENTAINER_IMAGE
LABEL org.opencontainers.image.version="${IMAGE_VERSION}" \
	org.opencontainers.image.revision="${VCS_REF}" \
	org.opencontainers.image.created="${BUILD_DATE}" \
	org.opencontainers.image.title="Agentainer Kelos variant" \
	org.opencontainers.image.description="Agentainer with the Kelos agent entrypoints, kelos-capture and the push sidecar" \
	org.opencontainers.image.base.name="${AGENTAINER_IMAGE}"

USER 61100
WORKDIR /workspace
HEALTHCHECK NONE
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/kelos_entrypoint.sh"]
CMD []
